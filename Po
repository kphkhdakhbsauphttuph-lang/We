-- ฟังก์ชันสร้างปุ่มเปิด/ปิด สวิตช์ทั่วไป
local function CreateToggleButton(name, text, positionY, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Size = UDim2.new(0.85, 0, 0, 40)
    Btn.Position = UDim2.new(0.075, 0, 0, positionY)
    Btn.BackgroundColor3 = Color3.fromRGB(55, 45, 50)
    Btn.TextColor3 = Color3.fromRGB(220, 200, 210)
    Btn.Text = text .. ": OFF"
    Btn.TextSize = 14
    Btn.Font = Enum.Font.SourceSansBold
    Btn.Parent = MainFrame

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Btn

    local state = false
    Btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Btn.BackgroundColor3 = Color3.fromRGB(235, 90, 140)
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Text = text .. ": ON"
        else
            Btn.BackgroundColor3 = Color3.fromRGB(55, 45, 50)
            Btn.TextColor3 = Color3.fromRGB(220, 200, 210)
            Btn.Text = text .. ": OFF"
        end
        callback(state)
    end)
    return Btn
end

